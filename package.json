{
  "name": "ac-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4399",
    "build": "next build",
    "prepare:standalone": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "npm run prepare:standalone && PORT=4399 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "node --test features/games/guiyang-mahjong/rules.test.ts features/games/bamboo-cicada/rules.test.ts features/games/planet-merge/rules.test.ts",
    "generate:nightfall-bgm": "node scripts/audio/generate-nightfall-bgm.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
